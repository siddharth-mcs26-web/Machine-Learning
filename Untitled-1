   "source": [
    "import numpy as np\n",
    "np.random.seed(7)\n",
    "n=100\n",
    "true_m, true_b = 2.5, 1.0\n",
    "X = np.random.randint(1, 11, size=30)\n",
    "Y = X*true_m + true_b\n",
    "split = int(0.8 * len(X))\n",
    "\n",
    "X_train = X[:split]\n",
    "X_test = X[split:]\n",
    "\n",
    "Y_train = Y[:split]\n",
    "Y_test = Y[split:]\n",
    "\n",
    "\n",
    "\n",
    "w = 0\n",
    "b = 0\n",
    "n = len(X)\n",
    "epochs = 1000\n",
    "learning_rate = 0.01\n",
    "for i in range(epochs):\n",
    "    y_pred = w * X_train + b\n",
    "    error = y_pred - Y_train\n",
    "    loss = np.mean(error**2)\n",
    "    \n",
    "    dw = 2/n * np.sum(X_train*error)\n",
    "    db = 2/n * np.sum(error)\n",
    "    \n",
    "    w = w - learning_rate*dw\n",
    "    b = b - learning_rate*db\n",
    "\n",
    "print(w)\n",
    "print(b)\n",
    "Y_prediction = X_test*w + b\n",
    "accuracy = np.mean(Y_prediction == Y_test)\n",
    "print(accuracy)"
   ]
  }
